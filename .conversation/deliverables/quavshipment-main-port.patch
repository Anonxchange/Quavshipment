+.qelvaron-document-page {
+  min-height: 100vh;
+  color: #17202d;
+  background: #f5f6f8;
+  font-family: Inter, Arial, sans-serif;
+}
+
+.qelvaron-page-header {
+  position: relative;
+  z-index: 2;
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: center;
+  gap: 28px;
+  padding: 18px clamp(20px, 4vw, 64px);
+  background: #fff;
+  border-bottom: 1px solid #e7e9ed;
+}
+
+.qelvaron-page-brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 190px;
+  color: #111827;
+  text-decoration: none;
+}
+
+.qelvaron-page-brand-mark {
+  display: grid;
+  width: 35px;
+  height: 35px;
+  place-items: center;
+  border-radius: 5px;
+  color: #121212;
+  background: #f15a24;
+  font-size: 21px;
+  font-weight: 800;
+  line-height: 1;
+}
+
+.qelvaron-page-brand-name {
+  display: grid;
+  gap: 3px;
+  font-size: 13px;
+  font-weight: 800;
+  letter-spacing: 0.075em;
+  line-height: 1;
+}
+
+.qelvaron-page-brand-name small {
+  color: #657080;
+  font-size: 8px;
+  font-weight: 700;
+  letter-spacing: 0.18em;
+}
+
+.qelvaron-page-nav {
+  position: static !important;
+  display: flex !important;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  min-width: 0;
+  padding: 0;
+  background: transparent;
+}
+
+.qelvaron-page-nav .nav-link {
+  padding: 8px 1px;
+  color: #283140;
+  font-size: 13px;
+  font-weight: 600;
+  line-height: 1.2;
+  text-decoration: none;
+  white-space: nowrap;
+}
+
+.qelvaron-page-nav .nav-link:hover,
+.qelvaron-page-nav .nav-link[aria-current="page"] {
+  color: #e84f1c;
+}
+
+.qelvaron-page-nav .nav-slash {
+  color: #c4c9d0;
+  font-size: 12px;
+}
+
+.qelvaron-page-contact {
+  display: inline-flex;
+  min-height: 42px;
+  align-items: center;
+  justify-content: center;
+  padding: 0 20px;
+  border-radius: 24px;
+  color: #151515;
+  background: #f5f5f5;
+  font-size: 13px;
+  font-weight: 700;
+  text-decoration: none;
+  white-space: nowrap;
+  transition: background-color 160ms ease, color 160ms ease;
+}
+
+.qelvaron-page-contact:hover {
+  color: #fff;
+  background: #f15a24;
+}
+
+.qelvaron-sr-only {
+  position: absolute;
+  overflow: hidden;
