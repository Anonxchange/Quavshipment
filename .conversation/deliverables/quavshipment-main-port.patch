utton--variant="base" class="primary-button w-inline-block"><div primary-button-text="" class="primary-button-text" aria-label="Get Quote"><span class="gsap_split_line gsap_split_line1" aria-hidden="true" style="text-align: center; position: relative; display: block;">Get Quote</span></div><div class="button-arrow-box"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _01"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _02"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg></div><div class="primary-hover-bg"></div></a></div></div></div><div class="nav-blur"></div><div class="w-nav-overlay" data-wf-ignore="" id="w-nav-overlay-0"></div></div><div class="main-wrapper"><section class="section section_career-hero"><div class="padding-global"><div class="container-large"><div data="items" class="padding-section-large about-hero-wrapper"><h1 class="career-hero-title" style="translate: none; rotate: none; scale: none; opacity: 1; transform: translate3d(0px, 0px, 0px);">Build Your Career in Global Logistics</h1><p class="text-size-large career-hero-desp" style="translate: none; rotate: none; scale: none; opacity: 1; transform: translate3d(0px, 0px, 0px);">Join Qelvaron and be part of a global team shaping the future of logistics through innovation, collaboration, and operational excellence.</p></div></div></div><div class="left-video-blur"></div><div class="left-video-blur right"></div><div class="about-hero-blur"></div></section><section class="section"><div class="padding-global"><div class="container-large"><div data="items" class="padding-section-large purpose-wrapper"><div data-wf--subtitle-wrap--variant="base" class="subtitle-block" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><p class="text-size-small subtitle-text">Why Work at Qelvaron</p></div><div class="purpose-right-contents" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><img src="https://cdn.prod.website-files.com/6a5e1b2ea7187af913158218/6a676a14c49c7722116a08c7_Rectangle%2039.webp" loading="lazy" id="w-node-_95b6edbb-e6cf-0aaf-be92-01104598f8f2-332ae4ed" alt="Port crane lifting a container amidst stacked shipping containers under clear sky." class="purpose-img"><div class="purpose-contents"><h2 class="purpose-title">A Workplace That Moves With Purpose</h2><div class="purpose-bottom"><p class="text-size-large purpose-desp">At Qelvaron, we believe logistics is driven by people. Our teams work together to solve complex challenges, support global businesses, and deliver reliable outcomes every day. We value accountability, growth, and teamwork, creating an environment where individuals can thrive and build meaningful careers.</p><a href="/contact/" primary-button="" data-wf--primary-button--variant="orange-big" class="primary-button w-variant-cc8aa4dc-1322-0bdd-cde4-d0224fe7b208 w-inline-block"><div primary-button-text="" class="primary-button-text" aria-label="View Open Positions"><span class="gsap_split_line gsap_split_line1" aria-hidden="true" style="text-align: center; position: relative; display: block;">View Open Positions</span></div><div class="button-arrow-box"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _01"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _02"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg></div><div class="primary-hover-bg w-variant-cc8aa4dc-1322-0bdd-cde4-d0224fe7b208"></div></a></div></div></div></div></div></div></section><section class="section"><div class="padding-global"><div class="container-large"><div class="padding-section-large operations-wrapper"><h2 data="single-item" class="operations-title" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);">Our culture defines how we work, collaborate, and grow together across global logistics operations.</h2><div data="single-item" class="operations-cards" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><div class="operations-card _01"><div class="inactive-operations-card _01"><div class="inactive-operations-detail"><p class="text-size-small text-primary-color">Collaboration</p><h3 class="heading-style-h1 display-three operations-num">01</h3></div></div><div class="active-operations-card _01"><div class="active-operations-details"><img src="https://cdn.prod.website-files.com/6a5e1b2ea7187af913158218/6a678dbe3d8cd47c12200694_Rectangle%2040.webp" loading="lazy" alt="Aerial view of stacked shipping containers near a railway and road in an industrial area." class="operation-img"><div class="operations-details"><p class="text-size-small text-primary-color">Collaboration</p><div class="operations-bottom"><h3 class="operations-text _01">One team, shared responsibility</h3><p class="text-size-large operations-desp">We work as a unified global team—sharing ideas, supporting one another, and collaborating across roles to deliver stronger results for our partners.</p></div></div></div></div></div><div class="operations-card _02"><div class="inactive-operations-card _02"><div class="inactive-operations-detail"><p class="text-size-small text-primary-color">Reliability</p><h3 class="heading-style-h1 display-three operations-num">02</h3></div></div><div class="active-operations-card _02"><div class="active-operations-details"><img src="https://cdn.prod.website-files.com/6a5e1b2ea7187af913158218/6a678f77419c5e476032a7d9_Rectangle%2040%20(1).webp" loading="lazy" alt="Two rows of large metal shipping containers, one yellow and one dark green, on a ship at sea." class="operation-img"><div class="operations-details"><p class="text-size-small text-primary-color">Reliability</p><div class="operations-bottom"><h3 class="operations-text _02">Working together across teams and borders</h3><p class="text-size-large operations-desp">We operate as one global team, sharing ideas, knowledge, and responsibility to achieve stronger results and better outcomes for our partners.</p></div></div></div></div></div><div class="operations-card _03"><div class="inactive-operations-card _03"><div class="inactive-operations-detail"><p class="text-size-small text-primary-color">Innovation</p><h3 class="heading-style-h1 display-three operations-num">03</h3></div></div><div class="active-operations-card _03"><div class="active-operations-details"><img src="https://cdn.prod.website-files.com/6a5e1b2ea7187af913158218/6a678ff37c96c043096bd30f_Rectangle%2040%20(2).webp" loading="lazy" alt="Overhead view of semi trucks lined up in lanes at a shipping container port with stacks of containers." class="operation-img"><div class="operations-details"><p class="text-size-small text-primary-color">Innovation</p><div class="operations-bottom"><h3 class="operations-text">Smarter ways to move forward</h3><p class="text-size-large operations-desp">We embrace technology and continuously refine our processes to create smarter, faster, and more efficient logistics solutions.</p></div></div></div></div></div><div class="operations-card _04"><div class="inactive-operations-card _04"><div class="inactive-operations-detail"><p class="text-size-small text-primary-color">Growth</p><h3 class="heading-style-h1 display-three operations-num">04</h3></div></div><div class="active-operations-card _04"><div class="active-operations-details"><img src="https://cdn.prod.website-files.com/6a5e1b2ea7187af913158218/6a67c3466339963dae9f4fef_Rectangle%2040.webp" loading="lazy" alt="Shipping containers stacked at a port with cranes and fog-covered mountains in the background." class="operation-img"><div class="operations-details"><p class="text-size-small text-primary-color">Growth</p><div class="operations-bottom"><h3 class="operations-text">Investing in people and potential</h3><p class="text-size-large operations-desp">We support continuous learning and development, creating opportunities for our people to grow professionally and build long-term careers.</p></div></div></div></div></div></div></div></div></div></section><section class="section"><div class="padding-global"><div class="container-large"><div class="padding-section-large impact-wrapper"><div data="items" class="impact-top"><div data-wf--subtitle-wrap--variant="base" class="subtitle-block" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><p class="text-size-small subtitle-text">What You’ll Do at Qelvaron</p></div><h2 class="heading-style-h1 impact-title" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);">Meaningful Work With Global Impact</h2></div><img class="impact-banner" src="https://cdn.prod.website-files.com/6a5e1b2ea7187af913158218/6a67c7c7edaa2e844425af60_Rectangle%2041.webp" alt="Cargo ship MSC ABY Monrovia loaded with shipping containers sailing on calm water under cloudy sky." data="single-item" loading="lazy" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><p data="single-item" class="impact-desp" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);">Working at Qelvaron means contributing to logistics operations that support international trade, supply chains, and business growth. Whether you’re managing shipments, optimizing processes, or supporting customers, your work directly impacts how goods move across the world.</p></div></div></div></section><section class="section section_openings"><div class="padding-global"><div class="container-large"><div data="items" class="padding-section-large openings-wrapper"><div class="openings-sticky" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><div data-wf--subtitle-wrap--variant="base" class="subtitle-block"><p class="text-size-small subtitle-text">Current Openings</p></div></div><div class="openings-details" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><h2 class="openings-title">Explore exciting career opportunities across our global operations. Whether you’re experienced in logistics or just starting your journey, Qelvaron offers roles where your skills can grow and make an impact.</h2><div class="career-cl-wrapper w-dyn-list"><div role="list" class="career-cl-list w-dyn-items"><div role="listitem" class="career-cl-item w-dyn-item"><div class="career-item-link"><div class="career-left-contents"><p class="text-size-large career-role-type">Full-Time / Mid-Level</p><h3 class="heading-style-h2 career-item-name">Logistics Operations Executive</h3><p class="text-size-large career-item-desp">Manage daily logistics operations and ensure timely, accurate shipment handling.</p></div><div class="career-right-contents"><a href="/career/" primary-button="" data-wf--primary-button--variant="secondary-outline" class="primary-button w-variant-ee95d469-9b3f-f6c2-eac7-d7e24fdb1510 w-inline-block"><div primary-button-text="" class="primary-button-text" aria-label="View Details"><span class="gsap_split_line gsap_split_line1" aria-hidden="true" style="text-align: center; position: relative; display: block;">View Details</span></div><div class="button-arrow-box"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _01"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _02"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg></div><div class="primary-hover-bg w-variant-ee95d469-9b3f-f6c2-eac7-d7e24fdb1510"></div></a></div><div class="career-item-line" style="translate: none; rotate: none; scale: none; width: 0%; transform: translate3d(0px, 0px, 0px);"></div></div></div><div role="listitem" class="career-cl-item w-dyn-item"><div class="career-item-link"><div class="career-left-contents"><p class="text-size-large career-role-type">Full-Time / Expert-Level</p><h3 class="heading-style-h2 career-item-name">Customer Support Coordinator</h3><p class="text-size-large career-item-desp">Support clients by coordinating shipments and providing timely updates across logistics processes.</p></div><div class="career-right-contents"><a href="/career/" primary-button="" data-wf--primary-button--variant="secondary-outline" class="primary-button w-variant-ee95d469-9b3f-f6c2-eac7-d7e24fdb1510 w-inline-block"><div primary-button-text="" class="primary-button-text" aria-label="View Details"><span class="gsap_split_line gsap_split_line1" aria-hidden="true" style="text-align: center; position: relative; display: block;">View Details</span></div><div class="button-arrow-box"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _01"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _02"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg></div><div class="primary-hover-bg w-variant-ee95d469-9b3f-f6c2-eac7-d7e24fdb1510"></div></a></div><div class="career-item-line" style="translate: none; rotate: none; scale: none; width: 0%; transform: translate3d(0px, 0px, 0px);"></div></div></div><div role="listitem" class="career-cl-item w-dyn-item"><div class="career-item-link"><div class="career-left-contents"><p class="text-size-large career-role-type">Full-Time / Entry-Level</p><h3 class="heading-style-h2 career-item-name">Warehouse Supervisor</h3><p class="text-size-large career-item-desp">Oversee warehouse operations, inventory accuracy, and team coordination.</p></div><div class="career-right-contents"><a href="/career/" primary-button="" data-wf--primary-button--variant="secondary-outline" class="primary-button w-variant-ee95d469-9b3f-f6c2-eac7-d7e24fdb1510 w-inline-block"><div primary-button-text="" class="primary-button-text" aria-label="View Details"><span class="gsap_split_line gsap_split_line1" aria-hidden="true" style="text-align: center; position: relative; display: block;">View Details</span></div><div class="button-arrow-box"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _01"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _02"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg></div><div class="primary-hover-bg w-variant-ee95d469-9b3f-f6c2-eac7-d7e24fdb1510"></div></a></div><div class="career-item-line" style="translate: none; rotate: none; scale: none; width: 0%; transform: translate3d(0px, 0px, 0px);"></div></div></div></div></div></div></div></div></div></section><section data-wf--faq-section--variant="career" class="section section_faq w-variant-d4f6b860-0d44-2cc0-3b1b-be121326ba2f"><div class="padding-global"><div class="container-large"><div class="padding-section-large faq-wrapper w-variant-d4f6b860-0d44-2cc0-3b1b-be121326ba2f"><div data="items" class="faq-top"><div data-wf--subtitle-wrap--variant="base" class="subtitle-block" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><p class="text-size-small subtitle-text">FAQ</p></div><h2 class="optimize-title" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);">Frequently asked questions</h2></div><div data="items" class="faq-bottom"><div id="w-node-_0f9f7724-8fd7-5d28-96f6-82b5fda986bc-fda986b2" class="faq-left" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><img alt="Warehouse worker in an orange safety vest scanning and checking items on high shelves." src="https://cdn.prod.website-files.com/6a5e1b2ea7187af913158218/6a6423d810a30074a08ea15d_Frame%201707480066%20(4).webp" loading="lazy" class="faq-img"><div class="faq-buttons"><a href="/contact/" primary-button="" data-wf--secondary-button--variant="white" class="secondary-button w-variant-cc3eb973-8864-8224-c466-80ccb68b491b w-inline-block"><div primary-button-text="" class="secondary-btn-text" aria-label="Get a Free Consultation"><span class="gsap_split_line gsap_split_line1" aria-hidden="true" style="text-align: center; position: relative; display: block;">Get a Free Consultation</span></div><div class="secondary-arrow-box"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _01"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 12" fill="none" class="button-arrow _02"><path d="M14 5.53023L0 5.53027M9.00002 0.530273L14 5.53023L9.00006 10.5303" stroke="currentColor" stroke-width="1.5"></path></svg></div><div class="secondary-hover-bg w-variant-cc3eb973-8864-8224-c466-80ccb68b491b"></div></a></div></div><div class="faq-items-wrapper" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><div class="faq-accordion cc-active"><div class="faq-question-wrap is-ques-active"><h3 class="heading-style-h5 faq-ques">What logistics services do you provide?</h3><div class="faq-arrow-box is-active-arrow-box"><div class="faq-hz-line is-icon-active"></div><div class="faq-vt-line is-icon-active"></div></div></div><div class="faq-answer-wrap"><p class="faq-ans">We offer end-to-end logistics solutions across air, sea, and land freight. Our services include international shipping, domestic transport, freight coordination, and tailored logistics planning to support businesses of all sizes.</p></div></div><div class="faq-accordion"><div class="faq-question-wrap"><h3 class="heading-style-h5 faq-ques">How do I get a quote or start shipping with Qelvaron?</h3><div class="faq-arrow-box"><div class="faq-hz-line"></div><div class="faq-vt-line"></div></div></div><div class="faq-answer-wrap"><p class="faq-ans">Simply contact our team with your shipment details, including cargo type, destination, and timeline. We’ll provide a customized quote and guide you through every step of the shipping process.</p></div></div><div class="faq-accordion"><div class="faq-question-wrap"><h3 class="heading-style-h5 faq-ques">Can Qelvaron handle time-sensitive or high-value cargo?</h3><div class="faq-arrow-box"><div class="faq-hz-line"></div><div class="faq-vt-line"></div></div></div><div class="faq-answer-wrap"><p class="faq-ans">Yes. We specialize in managing urgent and high-value shipments with secure handling, priority transportation, and reliable logistics solutions to ensure safe and timely delivery.</p></div></div><div class="faq-accordion"><div class="faq-question-wrap"><h3 class="heading-style-h5 faq-ques">Do you offer real-time shipment tracking?</h3><div class="faq-arrow-box"><div class="faq-hz-line"></div><div class="faq-vt-line"></div></div></div><div class="faq-answer-wrap"><p class="faq-ans">Yes. Our tracking system provides real-time shipment updates, allowing you to monitor your cargo's location and status throughout the entire transportation process.</p></div></div><div class="faq-accordion"><div class="faq-question-wrap"><h3 class="heading-style-h5 faq-ques">Can I track my shipments in real-time?</h3><div class="faq-arrow-box"><div class="faq-hz-line"></div><div class="faq-vt-line"></div></div></div><div class="faq-answer-wrap"><p class="faq-ans">Absolutely. You can access real-time tracking information to stay informed about your shipment's progress, estimated arrival, and delivery status from dispatch to destination.</p></div></div></div></div></div></div></div></section><section class="section section_cta"><div class="padding-global"><div class="container-large"><div class="padding-section-large cta-wrapper"><div data="items" class="cta-main-contents"><div class="cta-subtitle-block" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><img loading="lazy" src="https://cdn.prod.website-files.com/6a5e1b2ea7187af913158218/6a627f243f8a67f3a3f939cd_carrot.webp" alt="Orange carrot icon with three leaves on top." class="cta-subtitle-icon"><p class="text-size-small uppercase text-black">Your Delivery Partner</p></div><h2 class="heading-style-h1 display-three main-cta-title" style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);">Partner in your global logistics journey</h2><div style="translate: none; rotate: none; scale: none; opacity: 0; transform: translate3d(0px, 3.5rem, 0px);"><a href="/contact/" primary-button="" data-wf--secondary-button--variant="base" class="secondary-button w-inline-block"><div primary-button-text="